Items: {
	AugmentEssenceItem: {
		DisplayName: Plug-in Essence
		Tooltip: Used to buy or re-acquire Plug-in Chips from Mistress 2B.
	}

	MediGunItem: {
		DisplayName: Medi Gun MK I
		Tooltip:
			'''
			Hold to lock onto a nearby teammate and channel a healing beam
			Heals 3 HP per second
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK2Item: {
		DisplayName: Medi Gun MK II
		Tooltip:
			'''
			Hold to lock onto a nearby teammate and channel an advanced healing beam
			Heals 6 HP per second with extended tether range
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}
}

