Items: {
	AugmentEssenceItem: {
		DisplayName: Machine Core
		Tooltip: A pulsing power unit salvaged from machines, traded with Mistress 2B to acquire and re-forge Plug-in Chips.
	}

	SealedChipCacheItem: {
		DisplayName: Sealed Chip Cache
		Tooltip:
			'''
			Encrypted YoRHa combat salvage pod
			Right-click to decrypt and choose 1 of 3 Plug-in Chips
			Chip tier scales with your world's boss progression
			'''
	}

	MediGunItem: {
		DisplayName: Medi Gun MK I
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel a healing beam
			Heals 3 HP per second (tripled during ÜberCharge)
			Healing builds ÜberCharge over ~35 seconds
			Press Right-Click at 100% to pop ÜberCharge for 8 seconds:
			- Complete invulnerability to damage and knockback for you and your patient
			- +20% movement speed
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK2Item: {
		DisplayName: Medi Gun MK II
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel an advanced healing beam
			Heals 6 HP per second (tripled during ÜberCharge) with extended tether range
			Healing builds ÜberCharge over ~30 seconds
			Press Right-Click at 100% to pop Reinforced ÜberCharge for 8.5 seconds:
			- Complete invulnerability to damage and knockback for you and your patient
			- +25% movement speed and +10% damage
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK3Item: {
		DisplayName: Medi Gun MK III
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel an advanced spectral healing beam
			Heals 10 HP per second (tripled during ÜberCharge) with maximum tether range
			Healing builds ÜberCharge over ~25 seconds
			Press Right-Click at 100% to pop Prismatic Overdrive for 9 seconds:
			- Complete invulnerability to damage, knockback, and debuffs for you and your patient
			- +30% movement speed, +15% damage, and +15% critical strike chance
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}

	MediGunMK4Item: {
		DisplayName: Medi Gun MK IV
		Tooltip:
			'''
			Hold Left-Click to lock onto a nearby ally or town NPC and channel an ultimate celestial healing beam
			Heals 16 HP per second (tripled during ÜberCharge) with screen-wide tether range
			Healing builds ÜberCharge over ~20 seconds
			Press Right-Click at 100% to pop Celestial Apotheosis for 10 seconds:
			- Complete invulnerability to damage, knockback, and debuffs for you and your patient
			- +35% movement speed, +25% damage, +25% critical strike chance, and unlimited flight time
			Tether breaks if line of sight is obstructed or distance exceeds range
			'''
	}
}

